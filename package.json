    "react-dom": "19.2.5",
    "react-image-crop": "^11.0.10",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "swr": "^2.4.1",
