    "@supabase/supabase-js": "^2.101.1",
    "@tailwindcss/typography": "^0.5.19",
    "@vercel/speed-insights": "^2.0.0",
    "browser-image-compression": "^2.0.2",
    "d3": "^7.9.0",
    "d3-shape": "^3.2.0",
    "developer-icons": "^6.0.5",
    "dotenv": "^17.4.0",
    "emoji-mart": "^5.6.0",
    "gray-matter": "^4.0.3",
    "gsap": "^3.14.2",
    "image-size": "^2.0.2",
