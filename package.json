    "spotify:backfill-days": "tsx scripts/backfill-spotify-recently-played-days.ts",
    "spotify:sync-tags": "tsx scripts/sync-lastfm-tags.ts",
    "spotify:sync-tags:force": "tsx scripts/sync-lastfm-tags.ts --force"
  },
  "dependencies": {
