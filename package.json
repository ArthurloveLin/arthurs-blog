{
  "name": "wardrobe-picks",
  "version": "0.1.1",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build --turbopack",
    "start": "next start",
    "lint": "eslint",
    "lint:workers": "eslint -c eslint.workers.config.mjs workers/cloudflare-worker/src workers/genius-worker/src workers/wardrobe-supabase-worker/src",
    "check": "tsc --noEmit && eslint . && npm run check:workers",
