# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
**/node_modules
genius-worker/node_modules
poc-phase-1/node_modules
cloudflare-worker/node_modules

# cloudflare wrangler local state
**/.wrangler/

# wrangler local secrets (never commit)
**/.dev.vars
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# agents
.agents

# codegraph local index (rebuilt with `codegraph init -i`)
.codegraph/

# logs and temporary files
eslint_output.txt
scratch/
tmp/

# supabase local link state (regenerated by `npx supabase link`)
supabase/.temp/

# npm config
.npmrc

# vscode local workspace config
.vscode/

# gemini
.gemini

# build
dist/
.env*.local

# local one-off scripts with credentials
scripts/get-token.js
scripts/spotify_token.json
.env.test.local
__pycache__/
allure-results/
tests/perf/results*
tests/ai_hooks/report.json

# Local Playwright debug harness (not part of the app build)
scripts/debug/
