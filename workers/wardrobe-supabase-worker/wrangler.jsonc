{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "wardrobe-supabase",
  "main": "src/index.ts",
  "compatibility_date": "2026-05-01",
  "compatibility_flags": ["nodejs_compat"],
  "routes": [
    { "pattern": "api.arthurlovegrace.top", "custom_domain": true }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 1
    }
  },
  "vars": {
    "SUPABASE_HOST": "ymdwknyxmbhckgftfena.supabase.co",
    "CORS_ALLOW_ORIGIN": "https://arthurlovegrace.top"
  }
}